# Attestly backend configuration. Copy to .env and fill in as needed.
# Everything below is OPTIONAL — the app runs fully offline without any keys.

# --- Claude (drafting) ---
# Without this, unmatched questions use a flagged offline fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Stripe (self-serve billing) ---
# Without this, checkout returns a simulated URL you can confirm locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pre-created recurring Price IDs (else prices are created inline).
# Monthly:
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Annual ("2 months free" — $990 / $2,490 / $4,990 per year):
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_SCALE_YEARLY=

# --- Semantic search (optional) ---
# One-line toggle: with a Voyage AI key, answers + trust documents are embedded
# and retrieval matches by MEANING (paraphrases match), not just wording.
# Without it, the app falls back to lexical/fuzzy matching — no other change.
# Get a key at https://dash.voyageai.com  (very cheap; voyage-3.5-lite).
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5-lite

# --- Storage ---
# Leave DATABASE_URL blank for local dev (uses a local SQLite file, zero setup).
# Set it to a Postgres connection string (e.g. Supabase) for durable production
# storage — the app auto-detects it and creates its tables on startup.
DATABASE_URL=
ATTESTLY_APP_URL=http://localhost:5173
# ATTESTLY_DB_PATH=/absolute/path/to/attestly.db
# ATTESTLY_MAX_UPLOAD_MB=20        # reject uploads larger than this (DoS guard)

# --- Retrieval tuning (optional) ---
# ATTESTLY_FUZZY_THRESHOLD=88     # reuse a bank answer at/above this similarity
# ATTESTLY_CONTEXT_THRESHOLD=45   # pass matches at/above this to Claude as context
