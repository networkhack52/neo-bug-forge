# Neo Bug Forge — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Required ──────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Generate with: openssl rand -hex 32
API_SECRET_KEY=your-32-char-random-secret-here

# ── Environment ───────────────────────────────────────
# "development" or "production"
ENVIRONMENT=development

# ── Cloudflare origin protection (optional) ───────────
# Shared secret proving a request came through Cloudflare. Set the SAME value
# here (on Render) and as a Cloudflare Transform Rule that adds the request
# header  X-Origin-Secret: <this value>  to all requests. When set, requests
# hitting the origin directly (without it) are rejected. Leave empty to disable.
# Generate with: openssl rand -hex 32
ORIGIN_SECRET=
