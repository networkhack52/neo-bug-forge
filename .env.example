# Attestly backend configuration. Copy to .env and fill in as needed.
# Everything below is OPTIONAL — the app runs fully offline without any keys.

# --- Claude (drafting) ---
# Without this, unmatched questions use a flagged offline fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Stripe (self-serve billing) ---
# Without this, checkout returns a simulated URL you can confirm locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pre-created recurring Price IDs (else prices are created inline)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# --- App ---
ATTESTLY_APP_URL=http://localhost:5173
# ATTESTLY_DB_PATH=/absolute/path/to/attestly.db

# --- Retrieval tuning (optional) ---
# ATTESTLY_FUZZY_THRESHOLD=88     # reuse a bank answer at/above this similarity
# ATTESTLY_CONTEXT_THRESHOLD=45   # pass matches at/above this to Claude as context
